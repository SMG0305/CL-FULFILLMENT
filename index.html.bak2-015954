<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="CL Fulfillment is an Amazon distribution partner for legacy brands. We take proven products from established business owners and launch them on Amazon — handling everything from listing to fulfillment." />
  <meta name="theme-color" content="#0A0E1A" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='5' fill='%230A0E1A'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='Arial Black,Helvetica,sans-serif' font-weight='900' font-size='13' fill='%2322D3EE'%3ECL%3C/text%3E%3C/svg%3E" />
  <title>CL Fulfillment — Your Products. New Life.</title>
  <meta property="og:type" content="website" />
  <meta property="og:title" content="CL Fulfillment — Your Products. New Life." />
  <meta property="og:description" content="Amazon distribution partner for legacy brands. We launch proven products on Amazon and handle everything from listing to fulfillment." />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="CL Fulfillment — Your Products. New Life." />
  <meta name="twitter:description" content="Amazon distribution partner for legacy brands." />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0A0E1A; --bg2: #0F1524; --surface: #1A2236;
      --border: rgba(99,179,237,0.12); --border2: rgba(99,179,237,0.22);
      --blue: #3B82F6; --blue-bright: #60A5FA; --cyan: #22D3EE;
      --green: #10B981; --green-dim: rgba(16,185,129,0.12);
      --text: #E2E8F0; --text-dim: #8899AA; --white: #F8FAFC;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Sora', sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 4rem; background: rgba(10,14,26,0.9); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { font-size: 1.1rem; font-weight: 800; color: var(--white); }
    .nav-logo span { color: var(--cyan); }
    .nav-links { display: flex; gap: 2.5rem; align-items: center; }
    nav a { font-size: 0.83rem; font-weight: 500; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
    nav a:hover { color: var(--white); }
    .nav-cta { background: var(--blue) !important; color: var(--white) !important; padding: 0.55rem 1.3rem !important; border-radius: 6px; font-weight: 600 !important; box-shadow: 0 0 16px rgba(59,130,246,0.3); }
    .nav-cta:hover { background: var(--blue-bright) !important; }

    .hero {
      min-height: 100vh; display: grid; grid-template-columns: 1fr 1fr;
      padding-top: 72px; position: relative; overflow: hidden;
    }
    .hero::after {
      content: ''; position: absolute; top: -20%; right: -10%; pointer-events: none;
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(59,130,246,0.08) 0%, transparent 65%);
    }
    .hero-left { display: flex; flex-direction: column; justify-content: center; padding: 5rem 3rem 5rem 5.5rem; position: relative; z-index: 1; }
    .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.8rem; }
    .eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--cyan); box-shadow: 0 0 6px var(--cyan); }
    .hero h1 { font-size: clamp(2.8rem, 4.5vw, 4.6rem); font-weight: 800; line-height: 1.08; color: var(--white); margin-bottom: 1.6rem; letter-spacing: -0.02em; }
    .hero h1 em { font-style: normal; background: linear-gradient(90deg, var(--blue-bright), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .hero-desc { font-size: 1.05rem; line-height: 1.75; color: var(--text-dim); max-width: 440px; margin-bottom: 2.5rem; }
    .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
    .btn-primary { background: var(--blue); color: var(--white); padding: 0.9rem 2rem; border: none; border-radius: 6px; font-family: 'Sora', sans-serif; font-size: 0.88rem; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; box-shadow: 0 0 20px rgba(59,130,246,0.3); transition: background 0.2s, transform 0.2s, box-shadow 0.2s; }
    .btn-primary:hover { background: var(--blue-bright); transform: translateY(-2px); box-shadow: 0 0 30px rgba(59,130,246,0.5); }
    .btn-ghost { background: transparent; color: var(--text-dim); padding: 0.9rem 2rem; border: 1px solid var(--border2); border-radius: 6px; font-family: 'Sora', sans-serif; font-size: 0.88rem; font-weight: 500; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
    .btn-ghost:hover { border-color: var(--blue); color: var(--white); }

    .hero-right { display: flex; align-items: center; justify-content: center; padding: 4rem 4rem 4rem 2rem; position: relative; z-index: 1; }
    .panel { width: 100%; max-width: 420px; background: var(--surface); border: 1px solid var(--border2); border-radius: 12px; overflow: hidden; box-shadow: 0 32px 80px rgba(0,0,0,0.6); }
    .panel-bar { background: var(--bg2); border-bottom: 1px solid var(--border); padding: 0.85rem 1.3rem; display: flex; align-items: center; gap: 0.5rem; }
    .dot { width: 10px; height: 10px; border-radius: 50%; }
    .dot.r{background:#FF5F57;} .dot.y{background:#FEBC2E;} .dot.g{background:#28C840;}
    .panel-title { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; color: var(--text-dim); margin-left: 0.4rem; }
    .panel-body { padding: 1.5rem; }
    .kpi-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 0.8rem; margin-bottom: 1.2rem; }
    .kpi { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 0.9rem; }
    .kpi .val { font-size: 1.4rem; font-weight: 700; color: var(--white); }
    .kpi .val.b{color:var(--blue-bright);} .kpi .val.c{color:var(--cyan);} .kpi .val.gr{color:var(--green);}
    .kpi .lbl { font-size: 0.66rem; color: var(--text-dim); margin-top: 0.2rem; line-height: 1.3; }
    .bars-wrap { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; padding: 1.2rem; margin-bottom: 1rem; }
    .bars-header { display: flex; justify-content: space-between; margin-bottom: 0.8rem; }
    .bars-header span { font-size: 0.68rem; color: var(--text-dim); font-family: 'JetBrains Mono', monospace; }
    .bars { display: flex; align-items: flex-end; gap: 5px; height: 60px; }
    .bar { flex: 1; border-radius: 3px 3px 0 0; background: linear-gradient(180deg, var(--blue) 0%, rgba(59,130,246,0.3) 100%); }
    .bar.hi { background: linear-gradient(180deg, var(--cyan) 0%, rgba(34,211,238,0.2) 100%); }
    .rows { display: flex; flex-direction: column; gap: 0.55rem; }
    .row-item { display: flex; justify-content: space-between; align-items: center; background: var(--bg2); border: 1px solid var(--border); border-radius: 6px; padding: 0.65rem 0.9rem; }
    .row-item .rname { font-size: 0.78rem; color: var(--text); font-weight: 500; }
    .row-item .rval { font-family: 'JetBrains Mono', monospace; font-size: 0.73rem; color: var(--green); }
    .row-item .rbadge { font-size: 0.63rem; background: rgba(34,211,238,0.12); color: var(--cyan); padding: 0.15rem 0.45rem; border-radius: 3px; }

    .stats-strip { background: var(--bg2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 2.4rem 5rem; display: flex; justify-content: space-around; align-items: center; gap: 2rem; flex-wrap: wrap; position: relative; z-index: 1; }
    .stat-item { text-align: center; }
    .stat-item .big { font-size: 2.6rem; font-weight: 800; letter-spacing: -0.03em; background: linear-gradient(135deg, var(--blue-bright), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .stat-item .sub { font-size: 0.78rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.3rem; }
    .stat-div { width: 1px; height: 50px; background: var(--border); }

    section { padding: 6rem 5.5rem; position: relative; z-index: 1; }
    .section-label { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.8rem; }
    .section-label::before { content: ''; width: 20px; height: 1px; background: var(--cyan); box-shadow: 0 0 6px var(--cyan); }
    .section-title { font-size: clamp(1.9rem, 3vw, 2.9rem); font-weight: 800; line-height: 1.12; color: var(--white); margin-bottom: 1rem; max-width: 600px; letter-spacing: -0.02em; }
    .section-sub { font-size: 1rem; line-height: 1.75; color: var(--text-dim); max-width: 500px; margin-bottom: 3.5rem; }

    /* ---------- TIMELINE (step-by-step) ---------- */
    .steps-timeline { position: relative; padding: 1.5rem 0 1rem; }
    .timeline-items { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.25rem; position: relative; }
    .timeline-items::before {
      content: ''; position: absolute;
      top: 30px; left: 8%; right: 8%;
      height: 2px;
      background: linear-gradient(90deg, rgba(59,130,246,0.15) 0%, rgba(34,211,238,0.75) 20%, rgba(34,211,238,0.75) 80%, rgba(59,130,246,0.15) 100%);
      box-shadow: 0 0 14px rgba(34,211,238,0.35);
      z-index: 0;
    }
    .timeline-step { display: flex; flex-direction: column; align-items: center; text-align: center; position: relative; }
    .timeline-node {
      width: 60px; height: 60px; border-radius: 50%;
      background: var(--bg2);
      border: 2px solid var(--cyan);
      display: flex; align-items: center; justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 700; font-size: 0.95rem; color: var(--cyan);
      margin-bottom: 1.3rem;
      position: relative; z-index: 2;
      box-shadow: 0 0 18px rgba(34,211,238,0.3), inset 0 0 0 4px var(--bg);
      transition: transform 0.3s, box-shadow 0.3s, background 0.3s, color 0.3s;
    }
    .timeline-step:hover .timeline-node {
      transform: scale(1.08);
      background: var(--cyan);
      color: var(--bg);
      box-shadow: 0 0 30px rgba(34,211,238,0.6), inset 0 0 0 4px var(--bg);
    }
    .timeline-content .step-icon { font-size: 1.4rem; margin-bottom: 0.55rem; }
    .timeline-content h3 { font-size: 0.92rem; font-weight: 700; color: var(--white); margin-bottom: 0.45rem; line-height: 1.3; }
    .timeline-content p { font-size: 0.78rem; line-height: 1.6; color: var(--text-dim); }
    .timeline-step.is-cta .timeline-node {
      background: linear-gradient(135deg, var(--blue), #1D4ED8);
      border-color: var(--blue-bright);
      color: var(--white);
      font-size: 1.3rem;
      box-shadow: 0 0 22px rgba(59,130,246,0.55), inset 0 0 0 4px var(--bg);
    }
    .timeline-step.is-cta:hover .timeline-node {
      background: var(--blue-bright);
      color: var(--white);
      box-shadow: 0 0 36px rgba(96,165,250,0.7), inset 0 0 0 4px var(--bg);
    }
    .timeline-cta-btn {
      display: inline-block;
      background: var(--blue); color: var(--white);
      padding: 0.55rem 1.1rem;
      border-radius: 5px;
      font-family: 'Sora', sans-serif;
      font-size: 0.78rem; font-weight: 600;
      text-decoration: none;
      margin-top: 0.75rem;
      box-shadow: 0 0 14px rgba(59,130,246,0.35);
      transition: background 0.2s;
    }
    .timeline-cta-btn:hover { background: var(--blue-bright); }

    .why-section { background: var(--bg2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 6rem 5.5rem; }

    /* ---------- WHY PANEL (terminal / code-log) ---------- */
    .why-panel {
      width: 100%; max-width: 1000px; margin: 0 auto;
      background: var(--surface);
      border: 1px solid var(--border2);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    }
    .why-panel .panel-bar {
      background: var(--bg); border-bottom: 1px solid var(--border);
      padding: 0.85rem 1.3rem;
      display: flex; align-items: center; gap: 0.5rem;
    }
    .why-log {
      padding: 1.8rem 2.2rem 1.6rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 0.85rem; line-height: 1.7;
      background: var(--surface);
    }
    .log-line { color: var(--text-dim); margin-bottom: 0.3rem; }
    .log-prompt { color: var(--cyan); font-weight: 700; margin-right: 0.55rem; }
    .log-command { color: var(--blue-bright); }
    .log-arg { color: var(--text); }
    .log-cursor { color: var(--cyan); animation: blink 1.1s steps(1) infinite; }
    .log-output {
      border-left: 2px solid rgba(99,179,237,0.18);
      margin: 0.6rem 0 0.8rem 0.5rem;
      padding: 0.3rem 0 0.2rem 1.5rem;
    }
    .log-entry { margin-bottom: 1.6rem; }
    .log-entry:last-child { margin-bottom: 0.5rem; }
    .log-entry-header {
      display: flex; gap: 0.7rem; align-items: center; flex-wrap: wrap;
      font-family: 'JetBrains Mono', monospace;
      margin-bottom: 0.55rem;
    }
    .log-id { color: var(--text-dim); font-size: 0.78rem; }
    .log-status { color: var(--green); font-weight: 700; font-size: 0.88rem; }
    .log-icon { font-size: 1.05rem; }
    .log-key { color: var(--blue-bright); font-weight: 600; letter-spacing: 0.03em; font-size: 0.87rem; }
    .log-entry-body {
      color: var(--text);
      font-family: 'Sora', sans-serif;
      line-height: 1.7;
      font-size: 0.9rem;
      padding-left: 1.5rem;
      position: relative;
      max-width: 680px;
    }
    .log-entry-body::before {
      content: '→';
      position: absolute; left: 0; top: 0;
      color: var(--cyan);
      font-family: 'JetBrains Mono', monospace;
      opacity: 0.55;
    }
    @keyframes blink {
      0%, 50% { opacity: 1; }
      50.01%, 100% { opacity: 0; }
    }

    .results-section { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    .result-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .rc { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 1.8rem 1.5rem; }
    .rc .fig { font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.4rem; background: linear-gradient(135deg, var(--blue-bright), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
    .rc .desc { font-size: 0.82rem; color: var(--text-dim); line-height: 1.5; }
    .rc.wide { grid-column: span 2; display: flex; align-items: center; gap: 1.5rem; background: linear-gradient(135deg, rgba(59,130,246,0.1), rgba(34,211,238,0.05)); border-color: rgba(59,130,246,0.25); }
    .rc.wide .fig { font-size: 3rem; margin: 0; flex-shrink: 0; }
    .highlights { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 2rem; }
    .hl { display: flex; align-items: center; gap: 0.9rem; font-size: 0.88rem; color: var(--text-dim); }
    .hl-check { width: 20px; height: 20px; flex-shrink: 0; background: var(--green-dim); border: 1px solid rgba(16,185,129,0.3); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--green); font-size: 0.65rem; }

    .cta-section { background: var(--bg2); border-top: 1px solid var(--border); padding: 6rem 5.5rem; text-align: center; position: relative; overflow: hidden; }
    .cta-section::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 800px; height: 400px; background: radial-gradient(ellipse, rgba(59,130,246,0.07) 0%, transparent 65%); pointer-events: none; }
    .cta-section .section-label { justify-content: center; }
    .cta-section .section-title { margin: 0 auto 1rem; }
    .cta-section .section-sub { margin: 0 auto 2.8rem; }
    .cta-form { display: flex; flex-direction: column; gap: 0.8rem; max-width: 480px; margin: 0 auto 1.2rem; position: relative; }
    .cta-form input { padding: 0.9rem 1.2rem; background: var(--surface); border: 1px solid var(--border2); border-radius: 6px; font-family: 'Sora', sans-serif; font-size: 0.9rem; color: var(--white); outline: none; transition: border-color 0.2s; width: 100%; }
    .cta-form input:focus { border-color: var(--blue); }
    .cta-form input::placeholder { color: var(--text-dim); }
    .cta-form button { background: var(--blue); color: var(--white); border: none; padding: 0.95rem 1.8rem; border-radius: 6px; font-family: 'Sora', sans-serif; font-size: 0.9rem; font-weight: 600; cursor: pointer; margin-top: 0.4rem; box-shadow: 0 0 20px rgba(59,130,246,0.3); transition: background 0.2s, transform 0.2s; }
    .cta-form button:hover { background: var(--blue-bright); transform: translateY(-1px); }
    .cta-success { max-width: 480px; margin: 0 auto 1.2rem; padding: 1.4rem 1.5rem; background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; color: var(--green); font-size: 0.95rem; font-weight: 500; text-align: center; animation: fadeUp 0.5s ease; }
    .cta-error { padding: 0.85rem 1rem; background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.3); border-radius: 6px; color: #fca5a5; font-size: 0.85rem; text-align: center; font-family: 'Sora', sans-serif; }

    footer { background: var(--bg); border-top: 1px solid var(--border); padding: 2.4rem 5.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; position: relative; z-index: 1; }
    .footer-logo { font-size: 1rem; font-weight: 800; color: var(--white); }
    .footer-logo span { color: var(--cyan); }
    footer p { font-size: 0.78rem; color: var(--text-dim); }
    .footer-links { display: flex; gap: 2rem; }
    .footer-links a { font-size: 0.78rem; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--text); }

    @keyframes fadeUp { from{opacity:0;transform:translateY(28px);}to{opacity:1;transform:translateY(0);} }
    .fade-up { animation: fadeUp 0.65s ease forwards; }
    .d1{animation-delay:0.12s;opacity:0;} .d2{animation-delay:0.24s;opacity:0;} .d3{animation-delay:0.36s;opacity:0;}

    .cta-fineprint { font-size: 0.72rem; line-height: 1.6; color: var(--text-dim); margin-top: 0.9rem; text-align: left; }
    .cta-fineprint a { color: var(--blue-bright); text-decoration: none; border-bottom: 1px solid rgba(96,165,250,0.3); }
    .cta-fineprint a:hover { border-bottom-color: var(--blue-bright); }

    @media(max-width:900px){
      nav{padding:1rem 1.5rem;} .nav-links{gap:1rem;}
      .hero{grid-template-columns:1fr;}
      .hero-left{padding:3rem 1.5rem 2rem;} .hero-right{padding:1rem 1.5rem 3rem;}
      .stats-strip{padding:2rem 1.5rem;} .stat-div{display:none;}
      section{padding:4rem 1.5rem;}
      .why-grid{grid-template-columns:1fr;}
      .timeline-items{grid-template-columns:1fr; gap: 2rem; padding-left: 40px;}
      .timeline-items::before{top: 0; bottom: 0; left: 29px; right: auto; width: 2px; height: auto; background: linear-gradient(180deg, rgba(59,130,246,0.15) 0%, rgba(34,211,238,0.75) 15%, rgba(34,211,238,0.75) 85%, rgba(59,130,246,0.15) 100%);}
      .timeline-step{flex-direction: row; text-align: left; gap: 1.2rem; align-items: flex-start;}
      .timeline-node{margin-bottom: 0; margin-left: -40px; flex-shrink: 0;}
      .timeline-content{text-align: left; padding-top: 0.4rem;}
      .timeline-content .step-icon{margin-bottom: 0.4rem;}
      .why-section{padding:4rem 1.5rem;}
      .why-log{padding: 1.3rem 1.2rem 1.1rem; font-size: 0.8rem;}
      .log-output{padding-left: 1rem;}
      .log-entry-body{font-size: 0.88rem; padding-left: 1.2rem;}
      .results-section{grid-template-columns:1fr;padding:4rem 1.5rem;gap:3rem;}
      .rc.wide{grid-column:span 2;}
      .cta-section{padding:4rem 1.5rem;} .cta-form{flex-direction:column;}
      footer{padding:2rem 1.5rem;flex-direction:column;text-align:center;}
    }
  </style>
</head>
<body>

  <nav>
    <div class="nav-logo"><span>CL</span> Fulfillment</div>
    <div class="nav-links">
      <a href="#how">How It Works</a>
      <a href="#why">Why Us</a>
      <a href="#contact" class="nav-cta">Partner With Us</a>
    </div>
  </nav>

  <section class="hero">
    <div class="hero-left">
      <p class="eyebrow fade-up">// Amazon Distribution Partner</p>
      <h1 class="fade-up d1">Your Life's Work,<br/><em>Scaled</em> for the<br/>Digital Age.</h1>
      <p class="hero-desc fade-up d2">We take proven products from established business owners and launch them on Amazon — handling everything from listing to fulfillment so you can step back and watch revenue grow.</p>
      <div class="hero-actions fade-up d3">
        <a href="#contact" class="btn-primary">Start a Conversation</a>
        <a href="#how" class="btn-ghost">See How It Works</a>
      </div>
    </div>
    <div class="hero-right fade-up d2">
