  <section class="cta-section" id="contact">
    <p class="section-label">Get Started</p>
    <h2 class="section-title">Let's Have a Conversation.</h2>
    <p class="section-sub">If you've built something real and you're wondering what comes next, we'd love to hear your story.</p>
    <form class="cta-form" id="inquiry-form" onsubmit="handleInquiry(event)">
      <input type="text" id="biz-name" name="business_name" placeholder="Business name" required autocomplete="organization" />
      <input type="email" id="biz-email" name="email" placeholder="Email address" required autocomplete="email" />
      <input type="tel" id="biz-phone" name="phone" placeholder="Phone number" required autocomplete="tel" />
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" />
      <div class="cta-error" id="cta-error" style="display:none;">Something went wrong. Please try again in a moment.</div>
      <button type="submit">Get in Touch</button>
      <p class="cta-fineprint">By submitting, you agree we may contact you by phone or email about your inquiry. See our <a href="privacy.html">Privacy Notice</a> and <a href="terms.html">Terms of Use</a>.</p>
    </form>
    <div class="cta-success" id="cta-success" style="display:none;">
      ✓ Thanks — we'll reach out within one business day or less.
    </div>
  </section>

  <footer>
    <div class="footer-logo"><span>CL</span> Fulfillment</div>
    <p>Part of Capital Freight-US &middot; &copy; 2026 Capital Freight-US. All rights reserved.</p>
    <div class="footer-links">
      <a href="privacy.html">Privacy</a>
      <a href="terms.html">Terms</a>
      <a href="#contact">Contact</a>
    </div>
  </footer>

  <script>
    async function handleInquiry(e) {
      e.preventDefault();
      const form = document.getElementById('inquiry-form');
      const success = document.getElementById('cta-success');
      const errorEl = document.getElementById('cta-error');
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalBtnText = submitBtn.textContent;

      errorEl.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending...';

      const formData = new FormData(form);
      formData.append('access_key', '44fba177-886c-48f2-bd7b-79833abcf581');
      formData.append('subject', 'New CL Fulfillment inquiry from ' + (formData.get('business_name') || 'website visitor'));
      formData.append('from_name', 'CL Fulfillment Website');
      formData.append('source', 'CL Fulfillment');

      // Dated record of the submission, for contact-preference recordkeeping
      formData.append('submitted_at', new Date().toISOString());
      formData.append('submitted_from', window.location.href);

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: formData
        });
        const data = await response.json();
        if (data.success) {
          form.style.display = 'none';
          success.style.display = 'block';
          success.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          throw new Error(data.message || 'Submission failed');
        }
      } catch (err) {
        submitBtn.disabled = false;
        submitBtn.textContent = originalBtnText;
        errorEl.style.display = 'block';
      }
    }
  </script>

</body>
