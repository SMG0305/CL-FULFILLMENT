<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Terms of Use for clfulfill.com, operated by Capital Freight-US." />
  <meta name="theme-color" content="#0A0E1A" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='5' fill='%230A0E1A'/%3E%3Ctext x='16' y='22' text-anchor='middle' font-family='Arial Black,Helvetica,sans-serif' font-weight='900' font-size='13' fill='%2322D3EE'%3ECL%3C/text%3E%3C/svg%3E" />
  <title>Terms of Use — CL Fulfillment</title>
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Terms of Use — CL Fulfillment" />
  <meta property="og:description" content="Terms governing use of clfulfill.com." />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --bg: #0A0E1A; --bg2: #0F1524; --surface: #1A2236;
      --border: rgba(99,179,237,0.12); --border2: rgba(99,179,237,0.22);
      --blue: #3B82F6; --blue-bright: #60A5FA; --cyan: #22D3EE;
      --green: #10B981; --text: #E2E8F0; --text-dim: #8899AA; --white: #F8FAFC;
    }
    html { scroll-behavior: smooth; }
    body { font-family: 'Sora', sans-serif; background: var(--bg); color: var(--text); overflow-x: hidden; }
    body::before {
      content: ''; position: fixed; inset: 0; z-index: 0; pointer-events: none;
      background-image: linear-gradient(rgba(59,130,246,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(59,130,246,0.03) 1px, transparent 1px);
      background-size: 48px 48px;
    }
    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 1.2rem 4rem; background: rgba(10,14,26,0.9); backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .nav-logo { font-size: 1.1rem; font-weight: 800; color: var(--white); text-decoration: none; }
    .nav-logo span { color: var(--cyan); }
    .nav-links { display: flex; gap: 2.5rem; align-items: center; }
    nav a { font-size: 0.83rem; font-weight: 500; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
    nav a:hover { color: var(--white); }
    .nav-cta { background: var(--blue) !important; color: var(--white) !important; padding: 0.55rem 1.3rem !important; border-radius: 6px; font-weight: 600 !important; box-shadow: 0 0 16px rgba(59,130,246,0.3); }
    .nav-cta:hover { background: var(--blue-bright) !important; }

    .legal-wrap { position: relative; z-index: 1; max-width: 820px; margin: 0 auto; padding: 10rem 2rem 6rem; }
    .eyebrow { font-family: 'JetBrains Mono', monospace; font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--cyan); margin-bottom: 1.2rem; display: flex; align-items: center; gap: 0.8rem; }
    .eyebrow::before { content: ''; width: 28px; height: 1px; background: var(--cyan); box-shadow: 0 0 6px var(--cyan); }
    .legal-wrap h1 { font-size: clamp(2.1rem, 4vw, 3.2rem); font-weight: 800; line-height: 1.1; color: var(--white); letter-spacing: -0.02em; margin-bottom: 1rem; }
    .legal-meta { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--text-dim); line-height: 1.9; padding-bottom: 2rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); }
    .legal-meta strong { color: var(--text); font-weight: 500; }
    .legal-wrap h2 { font-size: 1.32rem; font-weight: 700; color: var(--white); margin: 3rem 0 1rem; letter-spacing: -0.01em; scroll-margin-top: 100px; }
    .legal-wrap h3 { font-size: 1rem; font-weight: 600; color: var(--white); margin: 1.8rem 0 0.6rem; }
    .legal-wrap p { font-size: 0.95rem; line-height: 1.85; color: var(--text-dim); margin-bottom: 1.1rem; }
    .legal-wrap li { font-size: 0.95rem; line-height: 1.8; color: var(--text-dim); margin-bottom: 0.6rem; }
    .legal-wrap ul, .legal-wrap ol { padding-left: 1.4rem; margin-bottom: 1.3rem; }
    .legal-wrap li::marker { color: var(--cyan); }
    .legal-wrap strong { color: var(--text); font-weight: 600; }
    .legal-wrap a { color: var(--blue-bright); text-decoration: none; border-bottom: 1px solid rgba(96,165,250,0.3); transition: border-color 0.2s; }
    .legal-wrap a:hover { border-bottom-color: var(--blue-bright); }
    .callout { background: var(--surface); border: 1px solid var(--border2); border-left: 3px solid var(--cyan); border-radius: 6px; padding: 1.3rem 1.5rem; margin: 1.6rem 0; }
    .callout p:last-child { margin-bottom: 0; }
    .callout p { font-size: 0.9rem; }
    .toc { background: var(--bg2); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem 1.8rem; margin-bottom: 3rem; }
    .toc p { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cyan); margin-bottom: 0.9rem; }
    .toc ol { columns: 2; column-gap: 2.5rem; padding-left: 1.1rem; margin-bottom: 0; }
    .toc li { font-size: 0.86rem; margin-bottom: 0.45rem; break-inside: avoid; }
    .toc a { color: var(--text-dim); border-bottom: none; }
    .toc a:hover { color: var(--white); }
    table.legal-table { width: 100%; border-collapse: collapse; margin: 1.4rem 0 1.8rem; font-size: 0.88rem; }
    table.legal-table th { text-align: left; font-family: 'JetBrains Mono', monospace; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cyan); font-weight: 500; padding: 0.7rem 1rem; border-bottom: 1px solid var(--border2); }
    table.legal-table td { padding: 0.9rem 1rem; border-bottom: 1px solid var(--border); color: var(--text-dim); line-height: 1.65; vertical-align: top; }
    .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    footer { background: var(--bg); border-top: 1px solid var(--border); padding: 2.4rem 5.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; position: relative; z-index: 1; }
    .footer-logo { font-size: 1rem; font-weight: 800; color: var(--white); }
    .footer-logo span { color: var(--cyan); }
    footer p { font-size: 0.78rem; color: var(--text-dim); }
    .footer-links { display: flex; gap: 2rem; }
    .footer-links a { font-size: 0.78rem; color: var(--text-dim); text-decoration: none; transition: color 0.2s; }
    .footer-links a:hover { color: var(--text); }
    @media(max-width:900px){
      nav{padding:1rem 1.5rem;}
      .nav-links{gap:1.2rem;}
      .nav-links a:not(.nav-cta){display:none;}
      .legal-wrap{padding:7rem 1.5rem 4rem;}
      .toc ol{columns:1;}
      footer{padding:2rem 1.5rem;flex-direction:column;text-align:center;}
    }
  </style>
</head>
<body>

  <nav>
    <a class="nav-logo" href="index.html"><span>CL</span> Fulfillment</a>
    <div class="nav-links">
